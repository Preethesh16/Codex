# Copy this file to .env in the same directory (packages/server/.env).
# .env is gitignored — NEVER commit the real key.
#
# Supply real secrets only in the untracked .env file.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MANAGER_MODEL=gpt-5.6-sol
OPENAI_SPECIALIST_MODEL=gpt-5.6-terra
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VIDEO_MODEL=sora-2
OPENAI_TTS_MODEL=tts-1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_RUN_TIMEOUT_MS=90000
# Local development may use `uploads`. For production, mount `/data` as a
# persistent volume and set each of the paths below under `/data`.
ORBIT_UPLOAD_DIR=uploads
ORBIT_DATA_DIR=uploads
ORBIT_DB_PATH=uploads/orbit-state.json
ORBIT_AUTH_PATH=uploads/orbit-auth.json
# Generate a long random value for production; do not commit it.
ORBIT_SESSION_SECRET=replace-with-a-long-random-secret
ORBIT_CLIENT_URL=http://localhost:3000
ORBIT_JSON_LIMIT=25mb
ORBIT_AI_REQUESTS_PER_MINUTE=20
STARTUPFORGE_URL=http://127.0.0.1:3001
STARTUPFORGE_SERVICE_TOKEN=replace-with-the-same-long-random-secret-used-by-startupforge
ORBIT_APPROVAL_TOKEN=replace-with-a-long-random-secret
